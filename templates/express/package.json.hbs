{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "type": "module",
  "description": "Generated by BackGen",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "{{#if (eq orm "prisma")}}prisma generate && {{/if}}{{#if (eq orm "drizzle")}}drizzle-kit generate && {{/if}}tsc",
    "start": "npm run build && node dist/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    {{#if (eq orm "prisma")}}
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    {{/if}}
    {{#if (eq orm "drizzle")}}
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    {{/if}}
    "postinstall": ""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.17.0",
    "xss": "^1.0.15",
    "zod": "^3.24.0"
    {{#if (or (eq orm "prisma") (eq orm "drizzle"))}}
    ,"pg": "^8.13.0"
    {{/if}}
    {{#if (eq orm "prisma")}}
    ,"@prisma/client": "^7.0.0"
    ,"@prisma/adapter-pg": "^7.0.0"
    {{/if}}
    {{#if (eq orm "drizzle")}}
    ,"drizzle-orm": "^0.45.2"
    {{/if}}
    {{#if (eq orm "mongoose")}}
    ,"mongoose": "^8.9.0"
    {{/if}}
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/express-mongo-sanitize": "^2.0.4",
    "eslint": "^9.0.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
    {{#if (or (eq orm "prisma") (eq orm "drizzle"))}}
    ,"@types/pg": "^8.11.10"
    {{/if}}
    {{#if (eq orm "prisma")}}
    ,"prisma": "^7.0.0"
    {{/if}}
    {{#if (eq orm "drizzle")}}
    ,"drizzle-kit": "^0.31.10"
    {{/if}}
  },
  "overrides": {
    "glob": "^13.0.6"
    {{#if (eq orm "drizzle")}}
    ,"esbuild": "^0.25.0"
    {{/if}}
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
