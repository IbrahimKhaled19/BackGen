NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/{{projectName}}"
LOG_LEVEL=info
# V4.6.1 base hardening
BODY_SIZE_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
# Empty = allow all (dev). Set in prod: CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ALLOWED_ORIGINS=
# Rate limit (opt-in via `backgen add rate-limit`)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REDIS_URL=
