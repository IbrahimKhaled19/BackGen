import type { Role } from "./role.types.js";

let prisma: any;
async function getDb() {
  if (!prisma) prisma = (await import("../../config/prisma.js")).default;
  return prisma;
}

export const roleService = {
  async create(data: { name: string; description?: string; permissions?: string[] }): Promise<Role> {
    const db = await getDb();
    return db.role.create({ data });
  },

  async findAll(): Promise<Role[]> {
    const db = await getDb();
    return db.role.findMany({ orderBy: { name: "asc" } });
  },

  async findById(id: string): Promise<Role | null> {
    const db = await getDb();
    return db.role.findUnique({ where: { id } });
  },

  async update(id: string, data: Partial<Role>): Promise<Role> {
    const db = await getDb();
    return db.role.update({ where: { id }, data });
  },

  async remove(id: string): Promise<void> {
    const db = await getDb();
    await db.role.delete({ where: { id } });
  },
};
