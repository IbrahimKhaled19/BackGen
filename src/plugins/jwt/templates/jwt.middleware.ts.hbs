import { Request, Response, NextFunction } from "express";
import jwt from "jsonwebtoken";
import { env } from "../config/env.js";
import { prisma } from "../config/database.js";
import { ApiError } from "../utils/api-error.js";
import { asyncHandler } from "../utils/async-handler.js";

export interface AuthPayload {
  userId: string;
  email: string;
  role: string;
  tokenVersion: number;
}

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Express {
    interface Request {
      user?: AuthPayload;
    }
  }
}

/**
 * Express middleware that authenticates requests via JWT Bearer token.
 *
 * Verifies the token signature (whitelisting only HS256 to prevent alg
 * confusion), looks up the user to validate tokenVersion (instant revocation),
 * and attaches the current role from the database so role changes take effect
 * immediately.
 *
 * Wrapped in asyncHandler because Express 4 does not catch rejected promises
 * from async middleware — without it a thrown ApiError would hang the request.
 *
 * @throws {ApiError} 401 Unauthorized if the token is missing, invalid, expired, or revoked
 */
export const authMiddleware = asyncHandler(
  async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    const authHeader = req.headers.authorization;

    if (!authHeader || !authHeader.startsWith("Bearer ")) {
      throw ApiError.unauthorized("Missing or invalid authorization header");
    }

    const token = authHeader.split(" ")[1];

    let payload: AuthPayload;
    try {
      // Explicit algorithm whitelist prevents alg confusion attacks
      payload = jwt.verify(token, env.JWT_SECRET, {
        algorithms: ["HS256"],
      }) as AuthPayload;
    } catch {
      throw ApiError.unauthorized("Invalid or expired token");
    }

    // Verify token version — allows immediate revocation of all user tokens
    const user = await prisma.user.findUnique({
      where: { id: payload.userId },
      select: { tokenVersion: true, role: true },
    });

    if (!user) {
      throw ApiError.unauthorized("User not found");
    }

    if (payload.tokenVersion !== user.tokenVersion) {
      throw ApiError.unauthorized("Token revoked. Please login again.");
    }

    // Fetch current role from DB so role changes take effect immediately
    req.user = { ...payload, role: user.role };
    next();
  }
);

/**
 * Non-enforcing identity resolver.
 *
 * Populates `req.user` when a valid token is present and calls next()
 * regardless. Registered globally so middleware that needs an identity —
 * notably `tenantMiddleware` — can require one, while route-level protection
 * stays with `authMiddleware`.
 */
export const optionalAuthMiddleware = asyncHandler(
  async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    const authHeader = req.headers.authorization;

    if (!authHeader || !authHeader.startsWith("Bearer ")) {
      next();
      return;
    }

    try {
      const payload = jwt.verify(authHeader.split(" ")[1], env.JWT_SECRET, {
        algorithms: ["HS256"],
      }) as AuthPayload;

      const user = await prisma.user.findUnique({
        where: { id: payload.userId },
        select: { tokenVersion: true, role: true },
      });

      if (user && payload.tokenVersion === user.tokenVersion) {
        req.user = { ...payload, role: user.role };
      }
    } catch {
      // Invalid token — stay anonymous and let route-level auth decide.
    }

    next();
  }
);