import { Request, Response, NextFunction } from "express";
import { getAuth } from "@clerk/express";
import { ApiError } from "../../utils/api-error.js";

declare global {
  namespace Express {
    interface Request {
      userId?: string;
    }
  }
}

/**
 * Clerk authentication middleware.
 * Verifies the session token from the Authorization header.
 * Sets req.userId with the authenticated Clerk user ID.
 */
export function clerkAuthMiddleware(
  req: Request,
  _res: Response,
  next: NextFunction
): void {
  try {
    const auth = getAuth(req);

    if (!auth.userId) {
      throw ApiError.unauthorized("Not authenticated");
    }

    req.userId = auth.userId;
    next();
  } catch (error) {
    if (error instanceof ApiError) throw error;
    throw ApiError.unauthorized("Invalid or expired session");
  }
}

/**
 * Role-based access middleware using Clerk public metadata.
 * Usage: requireClerkRole("admin")
 */
export function requireClerkRole(...roles: string[]) {
  return async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    if (!req.userId) {
      throw ApiError.unauthorized();
    }

    // Role checking via Clerk public metadata
    // Set roles in Clerk Dashboard > Users > user > Public metadata
    // Example: { "role": "admin" }
    const { clerkClient } = await import("@clerk/express");
    const user = await clerkClient.users.getUser(req.userId);
    const userRole = (user.publicMetadata?.role as string) ?? "user";

    if (!roles.includes(userRole)) {
      throw ApiError.forbidden("Insufficient permissions");
    }

    next();
  };
}
