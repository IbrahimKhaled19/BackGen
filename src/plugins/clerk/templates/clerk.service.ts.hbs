import { clerkClient } from "@clerk/express";
import { ApiError } from "../../utils/api-error.js";
import type { ClerkUser, ClerkWebhookEvent } from "./clerk.types.js";

export class ClerkService {
  async getUser(userId: string): Promise<ClerkUser> {
    try {
      const user = await clerkClient.users.getUser(userId);
      return user as unknown as ClerkUser;
    } catch {
      throw ApiError.notFound("User not found");
    }
  }

  async getUserByEmail(email: string): Promise<ClerkUser | null> {
    const users = await clerkClient.users.getUserList({
      emailAddress: [email],
    });
    return (users.data[0] as unknown as ClerkUser) ?? null;
  }

  async handleWebhook(event: ClerkWebhookEvent): Promise<void> {
    switch (event.type) {
      case "user.created":
        // Handle new user creation
        break;
      case "user.updated":
        // Handle user update
        break;
      case "user.deleted":
        // Handle user deletion
        break;
      default:
        break;
    }
  }
}
