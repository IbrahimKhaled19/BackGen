import type { Response } from "express";
import { logger } from "../services/logger.service.js";

export interface ErrorEnvelope {
  status: number;
  error: string;
  message: string;
  requestId?: string;
  errors?: Array<{ field: string; message: string }>;
  details?: unknown;
}

/**
 * Send a consistent JSON error envelope on the response.
 * { status, error (machine code), message, requestId, errors?, details? }
 */
export function sendError(
  res: Response,
  status: number,
  message: string,
  code?: string,
  extras?: { errors?: ErrorEnvelope["errors"]; details?: unknown }
): void {
  const envelope: ErrorEnvelope = {
    status,
    error: code ?? defaultCodeForStatus(status),
    message,
    requestId: (res.req as { id?: string } | undefined)?.id,
  };
  if (extras?.errors) envelope.errors = extras.errors;
  if (extras?.details) envelope.details = extras.details;
  if (status >= 500) {
    logger.error("server error", envelope);
  }
  res.status(status).json(envelope);
}

function defaultCodeForStatus(status: number): string {
  switch (status) {
    case 400: return "BAD_REQUEST";
    case 401: return "UNAUTHORIZED";
    case 403: return "FORBIDDEN";
    case 404: return "NOT_FOUND";
    case 408: return "TIMEOUT";
    case 409: return "CONFLICT";
    case 422: return "UNPROCESSABLE";
    case 429: return "RATE_LIMITED";
    case 500: return "INTERNAL";
    case 503: return "UNAVAILABLE";
    default: return status >= 500 ? "SERVER_ERROR" : "CLIENT_ERROR";
  }
}
