import rateLimit, { type RateLimitRequestHandler } from "express-rate-limit";
import RedisStore, { type RedisReply, type SendCommandFn } from "rate-limit-redis";
import { Redis } from "ioredis";
import { env } from "../config/env.js";
import { logger } from "../services/logger.service.js";

/**
 * Rate limiter applied to /api/* routes.
 * Uses Redis store when REDIS_URL is set, otherwise in-memory.
 * Standard headers + RFC 6585 legacy headers.
 */
function buildStore(): RedisStore | undefined {
  if (!env.REDIS_URL) return undefined;
  try {
    const client = new Redis(env.REDIS_URL, { lazyConnect: true });
    const sendCommand: SendCommandFn = (command, ...args) =>
      client.call(command, ...args) as Promise<RedisReply>;
    return new RedisStore({ sendCommand });
  } catch (err) {
    logger.warn("Redis store init failed, falling back to memory store", err);
    return undefined;
  }
}

export const rateLimitMw: RateLimitRequestHandler = rateLimit({
  windowMs: env.RATE_LIMIT_WINDOW_MS,
  max: env.RATE_LIMIT_MAX,
  standardHeaders: "draft-7",
  legacyHeaders: false,
  store: buildStore(),
  message: { status: 429, error: "RATE_LIMITED", message: "Too many requests" },
});
