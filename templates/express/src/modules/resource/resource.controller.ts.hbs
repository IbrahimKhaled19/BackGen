import { Request, Response } from "express";
import { {{ResourceName}}Service } from "./resource.service.js";
import { successResponse, createdResponse, messageResponse, paginatedResponse } from "../../utils/response.js";

const service = new {{ResourceName}}Service();

export class {{ResourceName}}Controller {
  async create(req: Request, res: Response): Promise<void> {
    const {{resourceName}} = await service.create(req.body);
    createdResponse(res, {{resourceName}});
  }

  async getById(req: Request, res: Response): Promise<void> {
    const {{resourceName}} = await service.getById(req.params.id);
    successResponse(res, {{resourceName}});
  }

  async list(req: Request, res: Response): Promise<void> {
    const { items, total } = await service.list(req.query as any);
    const page = Number(req.query.page) || 1;
    const limit = Number(req.query.limit) || 10;
    paginatedResponse(res, items, total, page, limit);
  }

  async update(req: Request, res: Response): Promise<void> {
    const {{resourceName}} = await service.update(req.params.id, req.body);
    successResponse(res, {{resourceName}});
  }

  async delete(req: Request, res: Response): Promise<void> {
    await service.delete(req.params.id);
    messageResponse(res, "{{ResourceName}} deleted successfully");
  }
}
