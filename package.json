{
  "name": "backgen",
  "version": "1.0.0",
  "description": "Generate production-ready backend projects in minutes",
  "main": "dist/index.js",
  "bin": {
    "backgen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
