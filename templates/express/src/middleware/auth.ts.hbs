import { Request, Response, NextFunction } from "express";

/**
 * Placeholder auth middleware.
 *
 * BackGen generates this file so that protected route modules compile before
 * an auth plugin is installed. It does NOT authenticate anything — it only
 * sets `req.user` to `undefined` and warns loudly.
 *
 * Run `backgen add jwt` (or `backgen add clerk`) to replace this file with a
 * real implementation. Until then every `authMiddleware`-protected route is
 * publicly reachable.
 */

export interface AuthPayload {
  userId: string;
  email: string;
  role: string;
  tokenVersion: number;
}

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Express {
    interface Request {
      user?: AuthPayload;
    }
  }
}

let warned = false;

export function authMiddleware(
  _req: Request,
  _res: Response,
  next: NextFunction
): void {
  if (!warned) {
    warned = true;
    console.warn(
      "[auth] No authentication provider installed — every route guarded by " +
        "authMiddleware is PUBLIC. Run `backgen add jwt` to protect this API."
    );
  }
  next();
}