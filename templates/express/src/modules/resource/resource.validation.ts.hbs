import { z } from "zod";

export const create{{ResourceName}}Schema = z.object({
  body: z.object({
    {{#each fields}}
    {{this.name}}: {{this.zodType}},
    {{/each}}
    {{#each relations}}
    {{#if (eq this.type "belongsTo")}}
    {{this.name}}Id: z.string().uuid(),
    {{/if}}
    {{/each}}
  }),
});

export const update{{ResourceName}}Schema = z.object({
  body: z.object({
    {{#each fields}}
    {{this.name}}: {{this.zodType}}.optional(),
    {{/each}}
    {{#each relations}}
    {{#if (eq this.type "belongsTo")}}
    {{this.name}}Id: z.string().uuid().optional(),
    {{/if}}
    {{/each}}
  }),
  params: z.object({
    id: z.string().uuid(),
  }),
});

export const get{{ResourceName}}Schema = z.object({
  params: z.object({
    id: z.string().uuid(),
  }),
});

export const list{{ResourceName}}Schema = z.object({
  query: z.object({
    page: z.coerce.number().positive().default(1),
    limit: z.coerce.number().positive().max(100).default(10),
    search: z.string().optional(),
  }),
});
