import type { Request, Response, NextFunction } from "express";
{{#if (eq orm "prisma")}}
import { prisma } from "../config/database.js";
{{/if}}
{{#if (eq orm "mongoose")}}
import { Organization, Membership } from "../models/index.js";
{{/if}}
{{#if (eq orm "drizzle")}}
import { db } from "../config/database.js";
import { Organization, Membership } from "../db/schema/index.js";
import { eq, and, isNull } from "drizzle-orm";
{{/if}}
import { ApiError } from "../utils/api-error.js";

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Express {
    interface Request {
      organization?: {
        id: string;
        slug: string;
      };
    }
  }
}

/**
 * V4.5 SaaS Core — Tenant scoping middleware.
 *
 * Resolves the active organization from either:
 *   1. `req.user.orgId` claim (set by jwt or clerk auth middleware)
 *   2. `x-org-id` request header (service-to-service callers)
 *
 * Attaches `req.organization` to the request. Rejects requests with no
 * authenticated user (401), no org context (400), or a non-existent /
 * soft-deleted org (404). Use after auth middleware, before routes.
 *
 * SECURITY: an unauthenticated request is rejected before the header is read,
 * and the header is only honoured for a user who is an ACTIVE member of that
 * org — so `x-org-id` cannot be used to hop between tenants.
 */
export async function tenantMiddleware(
  req: Request,
  _res: Response,
  next: NextFunction
): Promise<void> {
  try {
    const user = req.user;

    // Fail closed. Without a verified identity there is nothing to check
    // membership against, so an x-org-id header would grant access to any tenant.
    if (!user?.userId) {
      throw new ApiError(401, "Authentication required");
    }

    const userWithOrg = user as { orgId?: string; userId?: string };
    const orgId = userWithOrg.orgId ?? req.header("x-org-id");

    if (!orgId) {
      throw new ApiError(400, "Organization context required (x-org-id header or auth claim)");
    }

    // When orgId comes from the header (not an auth claim), verify membership.
    if (!userWithOrg.orgId) {
{{#if (eq orm "prisma")}}
      const membership = await prisma.membership.findFirst({
        where: {
          userId: userWithOrg.userId,
          organizationId: orgId,
          deletedAt: null,
          status: "ACTIVE",
        },
        select: { id: true },
      });
      if (!membership) {
        throw new ApiError(403, "Not a member of this organization");
      }
{{/if}}
{{#if (eq orm "mongoose")}}
      const membership = await Membership.findOne({
        userId: userWithOrg.userId,
        organizationId: orgId,
        deletedAt: null,
        status: "ACTIVE",
      }).select("_id").lean();
      if (!membership) {
        throw new ApiError(403, "Not a member of this organization");
      }
{{/if}}
{{#if (eq orm "drizzle")}}
      const membership = await db
        .select({ id: Membership.id })
        .from(Membership)
        .where(
          and(
            eq(Membership.userId, userWithOrg.userId),
            eq(Membership.organizationId, orgId),
            isNull(Membership.deletedAt),
            eq(Membership.status, "ACTIVE")
          )
        )
        .limit(1);
      if (!membership.length) {
        throw new ApiError(403, "Not a member of this organization");
      }
{{/if}}
    }

{{#if (eq orm "prisma")}}
    const org = await prisma.organization.findFirst({
      where: { id: orgId, deletedAt: null },
      select: { id: true, slug: true },
    });

    if (!org) {
      throw new ApiError(404, "Organization not found");
    }

    req.organization = org;
{{/if}}
{{#if (eq orm "mongoose")}}
    const orgDoc = await Organization.findOne({
      _id: orgId,
      deletedAt: null,
    }).select("slug").lean();

    if (!orgDoc) {
      throw new ApiError(404, "Organization not found");
    }

    req.organization = {
      id: orgId,
      slug: orgDoc.slug,
    };
{{/if}}
{{#if (eq orm "drizzle")}}
    const [org] = await db
      .select({ id: Organization.id, slug: Organization.slug })
      .from(Organization)
      .where(
        and(
          eq(Organization.id, orgId),
          isNull(Organization.deletedAt)
        )
      )
      .limit(1);

    if (!org) {
      throw new ApiError(404, "Organization not found");
    }

    req.organization = org;
{{/if}}

    next();
  } catch (err) {
    next(err);
  }
}