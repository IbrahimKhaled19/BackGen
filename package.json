{
  "name": "@ibrahimkhaled19/backgen",
  "version": "1.6.0",
  "type": "module",
  "description": "Generate production-ready backend projects in minutes",
  "main": "dist/index.js",
  "bin": {
    "backgen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Ibrahim Khaled",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IbrahimKhaled19/BackGen.git"
  },
  "homepage": "https://github.com/IbrahimKhaled19/BackGen#readme",
  "bugs": {
    "url": "https://github.com/IbrahimKhaled19/BackGen/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.15.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}