import { prisma } from "../../config/database.js";
import type { Create{{ResourceName}}Input, Update{{ResourceName}}Input, {{ResourceName}}Query } from "./{{resourceName}}.types.js";

export class {{ResourceName}}Repository {
  async create(data: Create{{ResourceName}}Input) {
    return prisma.{{resourceName}}.create({
      data,
      {{#if hasRelations}}
      include: {
        {{#each relations}}
        {{#if (eq this.type "belongsTo")}}
        {{this.name}}: true,
        {{/if}}
        {{/each}}
      },
      {{/if}}
    });
  }

  async findById(id: string, userId?: string) {
    const where: Record<string, unknown> = { id };
    if (userId) {
      where.userId = userId;
    }
    return prisma.{{resourceName}}.findFirst({
      where,
      {{#if softDelete}}
      // soft-delete: exclude tombstoned records
      {{/if}}
      {{#if hasRelations}}
      include: {
        {{#each relations}}
        {{this.name}}: true,
        {{/each}}
      },
      {{/if}}
    });
  }

  async findAll(query: {{ResourceName}}Query) {
    const { page = 1, limit = 10, search } = query;
    const skip = (page - 1) * limit;

    const where: Record<string, unknown> = {};
    {{#if softDelete}}
    where.deletedAt = null;
    {{/if}}
    if (search) {
      where.OR = [
        {{#each fields}}
        {{#if (eq this.type "string")}}
        { {{this.name}}: { contains: search, mode: "insensitive" as const } },
        {{/if}}
        {{/each}}
      ];
    }

    const [items, total] = await Promise.all([
      prisma.{{resourceName}}.findMany({
        where,
        skip,
        take: limit,
        orderBy: { createdAt: "desc" },
        {{#if hasRelations}}
        include: {
          {{#each relations}}
          {{this.name}}: true,
          {{/each}}
        },
        {{/if}}
      }),
      prisma.{{resourceName}}.count({ where }),
    ]);

    return { items, total };
  }

  async update(id: string, data: Update{{ResourceName}}Input) {
    return prisma.{{resourceName}}.update({
      where: { id },
      data,
      {{#if hasRelations}}
      include: {
        {{#each relations}}
        {{#if (eq this.type "belongsTo")}}
        {{this.name}}: true,
        {{/if}}
        {{/each}}
      },
      {{/if}}
    });
  }

  async delete(id: string) {
    {{#if softDelete}}
    return prisma.{{resourceName}}.update({
      where: { id },
      data: { deletedAt: new Date() },
    });
    {{else}}
    return prisma.{{resourceName}}.delete({ where: { id } });
    {{/if}}
  }

  {{#if softDelete}}
  async restore(id: string) {
    return prisma.{{resourceName}}.update({
      where: { id },
      data: { deletedAt: null },
    });
  }
  {{/if}}
}
