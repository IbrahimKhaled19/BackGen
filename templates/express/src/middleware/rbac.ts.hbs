import type { Request, Response, NextFunction } from "express";
{{#if (eq orm "prisma")}}
import { prisma } from "../config/database.js";
{{/if}}
{{#if (eq orm "mongoose")}}
import { Membership } from "../models/index.js";
{{/if}}
{{#if (eq orm "drizzle")}}
import { db } from "../config/database.js";
import { Membership } from "../db/schema/index.js";
import { eq, and, isNull } from "drizzle-orm";
{{/if}}
import { ApiError } from "../utils/api-error.js";

/**
 * V4.5 SaaS Core — Role-based access control.
 *
 * Four-tier hierarchy (rank 0-3):
 *   VIEWER (0) < MEMBER (1) < ADMIN (2) < OWNER (3)
 *
 * Use as route guard:
 *   router.delete("/:id", requireRole("ADMIN"), asyncHandler(...));
 */
export type Role = "OWNER" | "ADMIN" | "MEMBER" | "VIEWER";

const ROLE_RANK: Record<Role, number> = {
  VIEWER: 0,
  MEMBER: 1,
  ADMIN: 2,
  OWNER: 3,
};

export function requireRole(minimum: Role) {
  return async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    try {
      const user = req.user as { id?: string } | undefined;
      const userId = user?.id;
      const orgId = req.organization?.id;

      if (!userId) {
        throw new ApiError(401, "Authentication required");
      }
      if (!orgId) {
        throw new ApiError(400, "Organization context required (apply tenantMiddleware first)");
      }

{{#if (eq orm "prisma")}}
      const membership = await prisma.membership.findFirst({
        where: {
          userId,
          organizationId: orgId,
          deletedAt: null,
          status: "ACTIVE",
        },
        select: { role: true },
      });

      if (!membership) {
        throw new ApiError(403, "Not a member of this organization");
      }

      const userRole = membership.role as Role;
{{/if}}
{{#if (eq orm "mongoose")}}
      const membershipDoc = await Membership.findOne({
        user: userId,
        organization: orgId,
        deletedAt: null,
        status: "ACTIVE",
      }).select("role").lean();

      if (!membershipDoc) {
        throw new ApiError(403, "Not a member of this organization");
      }

      const userRole = membershipDoc.role as Role;
{{/if}}
{{#if (eq orm "drizzle")}}
      const [membership] = await db
        .select({ role: Membership.role })
        .from(Membership)
        .where(
          and(
            eq(Membership.userId, userId),
            eq(Membership.organizationId, orgId),
            isNull(Membership.deletedAt),
            eq(Membership.status, "ACTIVE")
          )
        )
        .limit(1);

      if (!membership) {
        throw new ApiError(403, "Not a member of this organization");
      }

      const userRole = membership.role as Role;
{{/if}}

      if (ROLE_RANK[userRole] < ROLE_RANK[minimum]) {
        throw new ApiError(403, `Requires ${minimum} role`);
      }

      next();
    } catch (err) {
      next(err);
    }
  };
}
