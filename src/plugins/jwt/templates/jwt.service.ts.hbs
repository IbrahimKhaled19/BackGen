import bcrypt from "bcryptjs";
import jwt, { type SignOptions } from "jsonwebtoken";
import crypto from "crypto";
import { prisma } from "../../config/database.js";
import { env } from "../../config/env.js";
import { ApiError } from "../../utils/api-error.js";
import type { RegisterInput, LoginInput, AuthResponse, TokenPair, RefreshResponse } from "./auth.types.js";

const MAX_LOGIN_ATTEMPTS = 5;
const LOCKOUT_DURATION_MS = 15 * 60 * 1000; // 15 minutes

// Security: hash refresh tokens before storing in DB
function hashToken(token: string): string {
  return crypto.createHash("sha256").update(token).digest("hex");
}

// Security: warn if JWT secret is weak or default
if (!env.JWT_SECRET || env.JWT_SECRET.length < 32 || env.JWT_SECRET.includes("your-jwt-secret")) {
  console.warn("[auth] JWT_SECRET is weak or using default value. Generate a strong random secret (32+ chars) for production.");
}

export class AuthService {
  /**
   * Register a new user account.
   * Hashes the password with bcrypt, creates the user record, issues an access + refresh token pair,
   * and stores the hashed refresh token in the database.
   * @param input - Registration payload (email + password meeting password strength rules)
   * @throws {ApiError} 409 Conflict if email is already registered
   */
  async register(input: RegisterInput): Promise<AuthResponse> {
    const existingUser = await prisma.user.findUnique({
      where: { email: input.email },
    });

    if (existingUser) {
      throw ApiError.conflict("Email already exists");
    }

    const hashedPassword = await bcrypt.hash(input.password, 10);

    const user = await prisma.user.create({
      data: {
        email: input.email,
        password: hashedPassword,
      },
    });

    const tokens = this.generateTokens({
      userId: user.id,
      email: user.email,
      role: user.role,
      tokenVersion: user.tokenVersion,
    });

    await this.saveRefreshToken(user.id, tokens.refreshToken);

    return {
      user: {
        id: user.id,
        email: user.email,
        role: user.role,
        createdAt: user.createdAt,
      },
      ...tokens,
    };
  }

  /**
   * Authenticate a user with email and password.
   * Enforces account lockout after MAX_LOGIN_ATTEMPTS consecutive failures (15-minute cooldown).
   * Resets loginAttempts on successful login. Issues a token pair and stores the hashed refresh token.
   * @param input - Login payload (email + password)
   * @throws {ApiError} 401 Unauthorized if credentials are invalid
   * @throws {ApiError} 429 Too Many Requests if account is temporarily locked
   */
  async login(input: LoginInput): Promise<AuthResponse> {
    const user = await prisma.user.findUnique({
      where: { email: input.email },
    });

    if (!user) {
      throw ApiError.unauthorized("Invalid credentials");
    }

    // Check account lockout
    if (user.lockoutUntil && user.lockoutUntil > new Date()) {
      const remainingMs = user.lockoutUntil.getTime() - Date.now();
      const remainingMin = Math.ceil(remainingMs / 60000);
      throw ApiError.tooManyRequests(`Account locked. Try again in ${remainingMin} minute(s).`);
    }

    const validPassword = await bcrypt.compare(input.password, user.password);

    if (!validPassword) {
      // Increment failed login attempts
      const attempts = user.loginAttempts + 1;

      if (attempts >= MAX_LOGIN_ATTEMPTS) {
        await prisma.user.update({
          where: { id: user.id },
          data: {
            loginAttempts: attempts,
            lockoutUntil: new Date(Date.now() + LOCKOUT_DURATION_MS),
          },
        });
      } else {
        await prisma.user.update({
          where: { id: user.id },
          data: { loginAttempts: attempts },
        });
      }

      throw ApiError.unauthorized("Invalid credentials");
    }

    // Reset login attempts on successful login
    await prisma.user.update({
      where: { id: user.id },
      data: { loginAttempts: 0, lockoutUntil: null },
    });

    const tokens = this.generateTokens({
      userId: user.id,
      email: user.email,
      role: user.role,
      tokenVersion: user.tokenVersion,
    });

    await this.saveRefreshToken(user.id, tokens.refreshToken);

    return {
      user: {
        id: user.id,
        email: user.email,
        role: user.role,
        createdAt: user.createdAt,
      },
      ...tokens,
    };
  }

  /**
   * Rotate a refresh token: verify the existing token's JWT signature, find its hash in the DB,
   * delete the old token, issue a new access + refresh token pair, and persist the new hashed token.
   * All operations occur inside a Prisma transaction to prevent TOCTOU race conditions.
   * If the old token is missing from the DB (already consumed), all user sessions are invalidated
   * as a theft-detection measure.
   * @param refreshToken - The current refresh token (raw JWT string)
   * @throws {ApiError} 401 Unauthorized if the token is invalid, expired, or already revoked
   */
  async refresh(refreshToken: string): Promise<RefreshResponse> {
    // Verify the refresh token JWT first (signature + expiry)
    let payload: { jti: string };
    try {
      payload = jwt.verify(refreshToken, env.JWT_REFRESH_SECRET, { algorithms: ["HS256"] }) as { jti: string };
    } catch {
      throw ApiError.unauthorized("Invalid or expired refresh token");
    }

    const tokenHash = hashToken(refreshToken);

    // Security: atomic rotation inside a transaction prevents TOCTOU race
    // where two parallel requests with the same refresh token could cause
    // false theft detection (both find the token, one deletes it, the other
    // triggers token wipe).
    const tokens = await prisma.$transaction(async (tx) => {
      const stored = await tx.refreshToken.findUnique({
        where: { token: tokenHash },
        include: { user: true },
      });

      if (!stored) {
        // Refresh token not found in DB — already consumed (theft detected).
        // Invalidate ALL refresh tokens for this user as a security measure.
        if (payload.jti) {
          const decoded = jwt.decode(refreshToken) as { sub?: string } | null;
          if (decoded?.sub) {
            await tx.refreshToken.deleteMany({ where: { userId: decoded.sub } });
          }
        }
        throw ApiError.unauthorized("Refresh token has been revoked. Please login again.");
      }

      if (stored.expiresAt < new Date()) {
        await tx.refreshToken.delete({ where: { id: stored.id } });
        throw ApiError.unauthorized("Refresh token expired");
      }

      // Delete old token
      await tx.refreshToken.delete({ where: { id: stored.id } });

      // Issue new token pair
      const newTokens = this.generateTokens({
        userId: stored.user.id,
        email: stored.user.email,
        role: stored.user.role,
        tokenVersion: stored.user.tokenVersion,
      });

      // Store new refresh token (hashed, with exact JWT expiry)
      const newTokenHash = hashToken(newTokens.refreshToken);
      const decodedExp = jwt.decode(newTokens.refreshToken) as { exp: number } | null;
      const expiresAt = decodedExp?.exp ? new Date(decodedExp.exp * 1000) : new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);

      await tx.refreshToken.create({
        data: {
          token: newTokenHash,
          userId: stored.user.id,
          expiresAt,
        },
      });

      return newTokens;
    });

    return {
      accessToken: tokens.accessToken,
      refreshToken: tokens.refreshToken,
    };
  }

  /**
   * Logout by deleting the stored refresh token (looked up by its SHA-256 hash).
   * Idempotent -- no error if the token was already deleted.
   * @param refreshToken - The raw refresh token JWT to revoke
   */
  async logout(refreshToken: string): Promise<void> {
    const tokenHash = hashToken(refreshToken);
    await prisma.refreshToken.deleteMany({
      where: { token: tokenHash },
    });
  }

  /**
   * Change the user's password. Validates the current password, hashes the new one,
   * increments tokenVersion (invalidating all existing access tokens), and deletes
   * all refresh tokens for the user (force-logout from all sessions).
   * @param userId - The id of the user changing their password
   * @param currentPassword - The user's current password for verification
   * @param newPassword - The new password to set (must meet password strength rules)
   * @throws {ApiError} 404 Not Found if user does not exist
   * @throws {ApiError} 401 Unauthorized if current password is incorrect
   */
  async changePassword(userId: string, currentPassword: string, newPassword: string): Promise<void> {
    const user = await prisma.user.findUnique({
      where: { id: userId },
    });

    if (!user) {
      throw ApiError.notFound("User not found");
    }

    const valid = await bcrypt.compare(currentPassword, user.password);
    if (!valid) {
      throw ApiError.unauthorized("Current password is incorrect");
    }

    const hashedPassword = await bcrypt.hash(newPassword, 10);

    // Increment tokenVersion to invalidate all existing sessions
    await prisma.user.update({
      where: { id: userId },
      data: {
        password: hashedPassword,
        tokenVersion: { increment: 1 },
      },
    });

    // Remove all refresh tokens for this user
    await prisma.refreshToken.deleteMany({
      where: { userId },
    });
  }

  private generateTokens(payload: { userId: string; email: string; role: string; tokenVersion: number }): TokenPair {
    const accessToken = jwt.sign(
      {
        userId: payload.userId,
        email: payload.email,
        role: payload.role,
        tokenVersion: payload.tokenVersion,
      },
      env.JWT_SECRET,
      { expiresIn: env.JWT_EXPIRES_IN, algorithm: "HS256" } as SignOptions
    );

    // Opaque refresh token: minimal payload, mapped via DB
    const jti = crypto.randomUUID();
    const refreshToken = jwt.sign(
      { jti, sub: payload.userId },
      env.JWT_REFRESH_SECRET,
      { expiresIn: env.JWT_REFRESH_EXPIRES_IN, algorithm: "HS256" } as SignOptions
    );

    return { accessToken, refreshToken };
  }

  private async saveRefreshToken(userId: string, token: string): Promise<void> {
    // Decode the refresh token to get its exact expiry from the JWT exp claim
    const decoded = jwt.decode(token) as { exp: number } | null;
    const expiresAt = decoded?.exp ? new Date(decoded.exp * 1000) : new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);

    // Store SHA-256 hash of refresh token, not the raw token
    const tokenHash = hashToken(token);

    await prisma.refreshToken.create({
      data: {
        token: tokenHash,
        userId,
        expiresAt,
      },
    });
  }
}
