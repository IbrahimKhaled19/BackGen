import type { Server } from "http";
import { logger } from "../services/logger.service.js";
import { prisma } from "../config/database.js";

/**
 * Wires SIGTERM + SIGINT handlers. Stops accepting new connections,
 * waits for in-flight requests to complete, closes Prisma, then exits.
 * Use from server.ts: attachGracefulShutdown(server)
 */
export function attachGracefulShutdown(server: Server, timeoutMs = 10000): void {
  const shutdown = (signal: string) => {
    logger.info(`Received ${signal}, starting graceful shutdown`);
    let forced = false;
    const forceKill = setTimeout(() => {
      forced = true;
      logger.error(`Forced exit after ${timeoutMs}ms`);
      process.exit(1);
    }, timeoutMs);
    forceKill.unref();

    server.close((err: Error | undefined) => {
      if (err) {
        logger.error("HTTP server close failed", err);
      } else {
        logger.info("HTTP server closed");
      }
      clearTimeout(forceKill);
      if (forced) return;
      prisma.$disconnect()
        .then(() => {
          logger.info("Prisma disconnected");
          process.exit(0);
        })
        .catch((err: unknown) => {
          logger.error("Prisma disconnect failed", err);
          process.exit(1);
        });
    });
  };

  process.on("SIGTERM", () => shutdown("SIGTERM"));
  process.on("SIGINT", () => shutdown("SIGINT"));
}
