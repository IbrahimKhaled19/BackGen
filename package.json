{
  "name": "@ibrahimkhaled19/backgen",
  "version": "1.14.1",
  "type": "module",
  "description": "Generate Express.js backend projects with Prisma, Drizzle, or Mongoose — CLI generator for boilerplate-free APIs with auth, multi-tenant, and Docker",
  "mcpName": "io.github.IbrahimKhaled19/backgen",
  "main": "dist/index.js",
  "bin": {
    "backgen": "dist/index.js",
    "backgen-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node dist/mcp/index.js",
    "mcp:dev": "tsx src/mcp/index.ts"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "express",
    "typescript",
    "prisma",
    "drizzle",
    "mongoose",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "api-generator",
    "boilerplate",
    "scaffolding",
    "crud",
    "codegen",
    "nodejs",
    "rest-api",
    "saas",
    "starter-kit",
    "backend-framework",
    "express-generator",
    "code-generator",
    "backend-generator"
  ],
  "author": "Ibrahim Khaled",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbrahimKhaled19/BackGen.git"
  },
  "homepage": "https://github.com/IbrahimKhaled19/BackGen#readme",
  "bugs": {
    "url": "https://github.com/IbrahimKhaled19/BackGen/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.15",
    "js-yaml": "^4.2.0",
    "ora": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
