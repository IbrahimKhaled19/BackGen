import { Request, Response, NextFunction } from "express";
import { getAuth, clerkClient } from "@clerk/express";
import { ApiError } from "../utils/api-error.js";
import { asyncHandler } from "../utils/async-handler.js";

export interface AuthPayload {
  userId: string;
  email: string;
  role: string;
  tokenVersion: number;
}

declare global {
  // eslint-disable-next-line @typescript-eslint/no-namespace
  namespace Express {
    interface Request {
      user?: AuthPayload;
      userId?: string;
    }
  }
}

/**
 * Clerk authentication middleware.
 *
 * Verifies the session token from the Authorization header, sets `req.userId`
 * with the Clerk user ID and `req.user` with the payload shape the generated
 * controllers read. Wrapped in asyncHandler because Express 4 does not catch
 * rejected promises from async middleware.
 */
export const authMiddleware = asyncHandler(
  async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    const auth = getAuth(req);

    if (!auth.userId) {
      throw ApiError.unauthorized("Not authenticated");
    }

    req.userId = auth.userId;
    req.user = {
      userId: auth.userId,
      email: "",
      role: "USER",
      tokenVersion: 0,
    };

    next();
  }
);

/**
 * Non-enforcing identity resolver — populates req.user when a Clerk session
 * is present, calls next() either way. Registered globally so tenant scoping
 * can require an identity.
 */
export const optionalAuthMiddleware = asyncHandler(
  async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
    const auth = getAuth(req);

    if (auth.userId) {
      req.userId = auth.userId;
      req.user = {
        userId: auth.userId,
        email: "",
        role: "USER",
        tokenVersion: 0,
      };
    }

    next();
  }
);

/**
 * Role-based access middleware using Clerk public metadata.
 * Usage: requireClerkRole("admin")
 */
export function requireClerkRole(...roles: string[]) {
  return asyncHandler(
    async (req: Request, _res: Response, next: NextFunction): Promise<void> => {
      if (!req.userId) {
        throw ApiError.unauthorized();
      }

      // Role checking via Clerk public metadata
      // Set roles in Clerk Dashboard > Users > user > Public metadata
      // Example: { "role": "admin" }
      const user = await clerkClient.users.getUser(req.userId);
      const userRole = (user.publicMetadata?.role as string) ?? "user";

      if (!roles.includes(userRole)) {
        throw ApiError.forbidden("Insufficient permissions");
      }

      next();
    }
  );
}